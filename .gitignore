### Secrets and machine-specific configuration ###
# Keep templates such as .env.example and .env.template under version control.
.env
.env.*
!.env.example
!.env.template
!.env.sample
*.pem
*.key
*.p12
*.pfx
*.jks
*.kdbx
secrets/
private/
credentials/
service-account*.json
*-service-account.json

### Local HEIMDALL execution state ###
# Authoritative records must be deliberately admitted to data/ and committed;
# local locks, caches, temporary downloads, and run outputs must not be.
.heimdall/
data/**/.locks/
data/**/.cache/
data/**/tmp/
data/**/temporary/
data/**/downloads/
data/**/staging/
data/**/runtime/
data/**/runs/
data/**/reports/
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal
*.db-shm

### Infrastructure / local tooling state ###
.terraform/
*.tfstate
*.tfstate.*
.serverless/
.aws-sam/
.azd/
